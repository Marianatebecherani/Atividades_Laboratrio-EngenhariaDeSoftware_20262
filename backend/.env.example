# Copie para backend/.env e ajuste conforme o seu ambiente.
# A porta deve ser a mesma definida em infra (POSTGRES_PORT, padrão 5432).
DATABASE_URL=postgresql+psycopg://catalogo:catalogo@localhost:5432/catalogo

# Origens autorizadas a chamar a API (frontend Vite em desenvolvimento).
CORS_ORIGENS=["http://localhost:5173"]

# Banco usado pelos testes automatizados (criado pelo docker compose de infra).
TEST_DATABASE_URL=postgresql+psycopg://catalogo:catalogo@localhost:5432/catalogo_test

# Administrador criado pelo seed (uv run python -m app.db.seed). Use valores próprios.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@catalogo.local
ADMIN_SENHA=troque-esta-senha

# Diretório com filmes.csv e posters/ usados pelo seed (padrão: database/seed na raiz).
# SEED_DIRETORIO=../database/seed
